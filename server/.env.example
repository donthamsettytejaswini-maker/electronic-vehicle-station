PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/evcharge
JWT_SECRET=replace_with_a_secure_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Phase 5 Billing & Payment Configuration
PAYMENT_PROVIDER=mock
BILLING_CURRENCY=INR
BILLING_CURRENCY_SYMBOL=₹
BILLING_TAX_RATE=0
BILLING_SERVICE_FEE=0

# Optional Stripe Configuration (Active when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr

# Phase 7 Feature Flags
ENABLE_MAPS=true
ENABLE_NOTIFICATIONS=true
ENABLE_REVIEWS=true
ENABLE_DEMAND_PREDICTION=true
ENABLE_DYNAMIC_PRICING=true
ENABLE_FLEET=true
ENABLE_OCPP=true
ENABLE_LOAD_MANAGEMENT=true
